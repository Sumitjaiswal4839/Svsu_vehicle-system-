// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model UserVehicleProfile {
  id           String   @id @default(uuid())
  name         String
  course       String
  semester     String
  faculty      String?  // Faculty name
  rollNo       String   @unique
  password     String   // Hashed password for security
  vehicleNo    String
  license      String?
  rcPhoto      String   // Mandatory RC photo URL
  idCardFront  String // Mandatory ID Card Front
  idCardBack   String // Mandatory ID Card Back
  profilePhoto String? // Optional profile photo
  lastLogin    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  entries      EntryRecord[]
  
  buildingId   String?
  building     Building? @relation(fields: [buildingId], references: [id])

  @@index([rollNo])
  @@index([vehicleNo])
}


model EntryRecord {
  id              String   @id @default(uuid())
  
  // Legacy Fields (kept for backward compatibility & direct logging)
  fullName        String?  @default("")
  rollNo          String?
  faculty         String?  @default("")
  course          String?
  semester        String?  @default("")
  vehicleNo       String?  // Shared field
  photoUrl        String?  // Legacy photo field
  
  // Profile Linkage
  profileId       String?  // Link to permanent user
  profile         UserVehicleProfile? @relation(fields: [profileId], references: [id])
  
  // Temporary Visitor Specifics
  visitorName     String?
  visitorPurpose  String?
  visitorContact  String?
  visitorPhoto    String?
  
  // Visitor Linkage
  visitorId       String?
  visitor         VisitorEntry? @relation("VisitorToEntry", fields: [visitorId], references: [id])

  entryTime       DateTime @default(now())

  exitTime        DateTime?
  isTemporary     Boolean  @default(false)

  // Building Context
  buildingId      String?
  building        Building? @relation(fields: [buildingId], references: [id])

  @@index([profileId])
  @@index([isTemporary])
  @@index([vehicleNo])
  @@index([rollNo])
}



model User {
  id           String  @id @default(uuid())
  username     String  @unique
  password     String
  role         String  @default("GUARD") // GUARD or ADMIN
  isAuthorized Boolean @default(false)
  sessions     Session[]
  auditLogs    AuditLog[]

  buildingId   String?
  building     Building? @relation(fields: [buildingId], references: [id])
}

model Building {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique // e.g., 1E, 2E, 3E, 2W, 3W, Workshop, Gymnasium
  guards    User[]
  students  UserVehicleProfile[]
  entries   EntryRecord[]
  visitors  VisitorEntry[]
  createdAt DateTime @default(now())
}

model VisitorEntry {
  id            String    @id @default(uuid())
  name          String
  purpose       String
  contact       String?
  photo         String?
  buildingId    String?
  building      Building? @relation(fields: [buildingId], references: [id])
  entryTime     DateTime  @default(now())
  exitTime      DateTime?
  isHackathon   Boolean   @default(false)
  createdAt     DateTime  @default(now())

  entries       EntryRecord[] @relation("VisitorToEntry")

  @@index([buildingId])

}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // LOGIN, ENTRY_AUTH, EXIT_AUTH, VISITOR_ADD, ADMIN_UNLOCK
  resource  String?  // e.g., "Vehicle HR26-1234"
  metadata  Json?    // Extra info (Browser, IP, etc.)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}


